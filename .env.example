APP_NAME=youtude
APP_ENV=dev
DEBUG=true

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://youtude:youtude@localhost:5432/youtude
TEST_DATABASE_URL=postgresql+asyncpg://youtude:youtude@localhost:5432/youtude_test

# Безопасность
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3-совместимое хранилище (MinIO / AWS S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=youtude
S3_REGION=us-east-1
S3_USE_SSL=false